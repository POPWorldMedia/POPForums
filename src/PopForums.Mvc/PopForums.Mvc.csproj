<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<Description>PopForums Mvc Class Library</Description>
		<VersionPrefix>23.0.0</VersionPrefix>
		<Authors>Jeff Putz</Authors>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>PopForums.Mvc</AssemblyName>
		<PackageId>PopForums.Mvc</PackageId>
		<TargetLatestRuntimePatch>true</TargetLatestRuntimePatch>
		<AddRazorSupportForMvc>true</AddRazorSupportForMvc>
		<PackageProjectUrl>https://github.com/POPWorldMedia/POPForums</PackageProjectUrl>
		<RepositoryUrl>https://github.com/POPWorldMedia/POPForums</RepositoryUrl>
		<Copyright>2026, POP World Media, LLC</Copyright>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<!--This is an important line to trigger the hot reload:-->
		<AssignTargetPathsDependsOn>CompileTypeScript;BuildFrontendAssets;$(AssignTargetPathsDependsOn)</AssignTargetPathsDependsOn>
		<DefineStaticWebAssetsDependsOn>CompileTypeScript;BuildFrontendAssets;$(DefineStaticWebAssetsDependsOn)</DefineStaticWebAssetsDependsOn>
		<ResolveStaticWebAssetsInputsDependsOn>CompileTypeScript;BuildFrontendAssets;$(ResolveStaticWebAssetsInputsDependsOn)</ResolveStaticWebAssetsInputsDependsOn>
		<StaticWebAssetBasePath>/PopForums</StaticWebAssetBasePath>
	</PropertyGroup>

	<ItemGroup>
		<FrontendAssetInput Include="Client\**\*.ts" />
		<FrontendAssetInput Include="wwwroot\Admin.js" />
		<FrontendAssetInput Include="wwwroot\*.css" />
		<FrontendAssetInput Include="package.json" />
	</ItemGroup>

	<!--Minifies wwwroot/*.js and *.css and copies vendored node_modules assets into wwwroot/lib.
	    Runs after CompileTypeScript (which produces wwwroot/PopForums.js) and before the static
	    web assets are scanned, so it works identically under `dotnet build`, CI, and any IDE -
	    no editor-specific task runner binding required. Requires `npm install` to have been run.
	    Inputs/Outputs make this a no-op when nothing relevant changed (e.g. a .cs-only edit),
	    which matters because this is also wired into the hot-reload rebuild path below - without
	    it, every keystroke-triggered rebuild would re-copy the full vendor asset set.-->
	<Target Name="BuildFrontendAssets" DependsOnTargets="CompileTypeScript"
	        Inputs="@(FrontendAssetInput)" Outputs="wwwroot\lib\PopForums\dist\PopForums.min.js">
		<Exec Command="node build.js" WorkingDirectory="$(MSBuildProjectDirectory)" EnvironmentVariables="POPFORUMS_SKIP_TSC=1" />
	</Target>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<PackageReference Include="Microsoft.TypeScript.MSBuild" Version="6.0.3">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="PopIdentity" Version="4.5.0" />
		<ProjectReference Include="..\PopForums\PopForums.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <TypeScriptCompile Remove="node_modules\**" />
	</ItemGroup>

	<!--necessary to prevent pack in nuget package-->
	<ItemGroup>
		<Content Remove="Client\tsconfig.json" />
		<Content Remove="package-lock.json" />
		<Content Remove="package.json" />
		<Content Remove="wwwroot\PopForums.js" />
	</ItemGroup>

	<!--Include generated TypeScript output after compilation-->
	<ItemGroup>
		<Content Include="wwwroot\PopForums.js" Condition="Exists('wwwroot\PopForums.js')" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="wwwroot\lib\" />
	</ItemGroup>

	<!--necessary to prevent pack in nuget package-->
	<ItemGroup>
	  <TypeScriptCompile Include="Client\tsconfig.json" />
	  <None Include="package-lock.json" />
	  <None Include="package.json" />
	</ItemGroup>

	<ItemGroup>
	</ItemGroup>

</Project>
