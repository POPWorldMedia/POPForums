@model List<PopForums.Models.Subscriptions.SubscriptionHistory>
@{
	ViewBag.Title = PopForums.Resources.Account + " - " + PopForums.Resources.Subscriptions;
	Layout = "~/Areas/Forums/Views/Shared/PopForumsMaster.cshtml";
}

<h1>@PopForums.Resources.Account - @PopForums.Resources.Subscriptions</h1>
<ul id="TopBreadcrumb" class="breadcrumb sticky-top">
	<li class="breadcrumb-item"><a asp-controller="@HomeController.Name" asp-action="Index">@PopForums.Resources.Forums</a></li>
	<li class="breadcrumb-item">@PopForums.Resources.Account</li>
	<li class="breadcrumb-item dropdown">
		<a class="dropdown-toggle" data-bs-toggle="dropdown" href="#" aria-haspopup="true" aria-expanded="false" id="SubProfileMenu">@PopForums.Resources.Subscriptions</a>
		<div class="dropdown-menu" aria-labelledby="SubProfileMenu">
			<a class="dropdown-item" asp-action="Subscriptions">@PopForums.Resources.Subscriptions</a>
			<a class="dropdown-item" asp-action="EditProfile">@PopForums.Resources.EditYourProfile</a>
			<a class="dropdown-item" asp-action="Security">@PopForums.Resources.ChangeYourEmailPassword</a>
			<a class="dropdown-item" asp-action="ManagePhotos">@PopForums.Resources.ManageYourPhotos</a>
		</div>
	</li>
</ul>

<h2>Subscription History</h2>

@if (Model.Count == 0)
{
	<div class="alert alert-info">No subscription history.</div>
}
else
{
	<table class="table table-hover mt-3">
		<thead>
			<tr>
				<th>@PopForums.Resources.EventTime</th>
				<th>@PopForums.Resources.Message</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model)
			{
				<tr>
					<td class="text-nowrap">@item.TimeStamp.ToString("g")</td>
					<td>@item.Message</td>
				</tr>
			}
		</tbody>
	</table>
}
