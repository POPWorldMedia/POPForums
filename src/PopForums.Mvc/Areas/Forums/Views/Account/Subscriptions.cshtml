@model SubscriptionsViewModel
@inject ISettingsManager SettingsManager
@{
	ViewBag.Title = PopForums.Resources.Account + " - " + PopForums.Resources.Subscriptions;
	Layout = "~/Areas/Forums/Views/Shared/PopForumsMaster.cshtml";
}

<h1>@PopForums.Resources.Account - @PopForums.Resources.Subscriptions</h1>
<ul id="TopBreadcrumb" class="breadcrumb sticky-top">
	<li class="breadcrumb-item"><a asp-controller="@HomeController.Name" asp-action="Index">@PopForums.Resources.Forums</a></li>
	<li class="breadcrumb-item">@PopForums.Resources.Account</li>
	<li class="breadcrumb-item dropdown">
		<a class="dropdown-toggle" data-bs-toggle="dropdown" href="#" aria-haspopup="true" aria-expanded="false" id="SubProfileMenu">@PopForums.Resources.Subscriptions</a>
		<div class="dropdown-menu" aria-labelledby="SubProfileMenu">
			<a class="dropdown-item" asp-action="EditProfile">@PopForums.Resources.EditYourProfile</a>
			<a class="dropdown-item" asp-action="Security">@PopForums.Resources.ChangeYourEmailPassword</a>
			<a class="dropdown-item" asp-action="ManagePhotos">@PopForums.Resources.ManageYourPhotos</a>
		</div>
	</li>
</ul>

@if (SettingsManager.Current.IsSubscriptionEnabled)
{
	<h2>@PopForums.Resources.CurrentSubscription</h2>
	@if (!Model.IsSubscriber)
	{
		<div class="alert alert-info">
			@PopForums.Resources.NotSubscribed
		</div>
	}
	else
	{
		<div class="my-3">
			<strong>@PopForums.Resources.Expires:</strong> @(Model.Expiration.HasValue ? Model.Expiration.Value.ToString("D") : string.Empty)<br/>
			<strong>@PopForums.Resources.CurrentSubscription:</strong> @Model.SkuName - @Model.Months @PopForums.Resources.Months<br/>
			<strong>@PopForums.Resources.CardNumber:</strong> &bull;&bull;&bull;&bull; @Model.Last4 <a asp-action="SubscriptionCardUpdate">(@PopForums.Resources.UpdateCard)</a><br/>
			<strong>@PopForums.Resources.AutoRenewal:</strong> @(Model.IsAutoRenewal ? PopForums.Resources.On : PopForums.Resources.Off)
			<form asp-action="ToggleAutoRenewal" method="post" class="d-inline ms-2">
				<button type="submit" class="btn btn-link p-0 align-baseline">(@(Model.IsAutoRenewal ? PopForums.Resources.TurnOff : PopForums.Resources.TurnOn))</button>
			</form>
		</div>
	}

	@if (!Model.Expiration.HasValue || Model.Expiration.Value <= DateOnly.FromDateTime(DateTime.UtcNow))
	{
		<p><a asp-action="BuySubscription" class="btn btn-primary my-5">@PopForums.Resources.BuySubscription</a></p>
	}

	<p><a asp-action="SubscriptionHistory">@PopForums.Resources.ViewSubscriptionHistory</a></p>
}
else
{
	<div class="alert alert-warning">
		@PopForums.Resources.SubscriptionsNotEnabled
	</div>
}