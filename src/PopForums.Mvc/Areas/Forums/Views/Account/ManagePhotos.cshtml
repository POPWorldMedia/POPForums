@model UserEditPhoto
@inject IConfig Config
@inject ISettingsManager SettingsManager

@{
	ViewBag.Title = PopForums.Resources.Account + " - " + PopForums.Resources.ManagePhotos;
	Layout = "~/Areas/Forums/Views/Shared/PopForumsMaster.cshtml";
	var settings = SettingsManager.Current;
}

<h1>@PopForums.Resources.Account - @PopForums.Resources.ManagePhotos</h1>
<ul id="TopBreadcrumb" class="breadcrumb sticky-top">
	<li class="breadcrumb-item"><a asp-controller="@HomeController.Name" asp-action="Index">@PopForums.Resources.Forums</a></li>
	<li class="breadcrumb-item">@PopForums.Resources.Account</li>
	<li class="breadcrumb-item dropdown">
		<a class="dropdown-toggle" data-bs-toggle="dropdown" href="#" aria-haspopup="true" aria-expanded="false" id="SubProfileMenu">@PopForums.Resources.ManagePhotos</a>
		<div class="dropdown-menu" aria-labelledby="SubProfileMenu">
			<a class="dropdown-item" asp-action="EditProfile">@PopForums.Resources.EditYourProfile</a>
			@if (!Config.IsOAuthOnly)
			{
				<a class="dropdown-item" asp-action="Security">@PopForums.Resources.ChangeYourEmailPassword</a>
				<a class="dropdown-item" asp-action="ExternalLogins">@PopForums.Resources.ExternalLogins</a>
			}
			@if (SettingsManager.Current.IsSubscriptionEnabled)
			{
				<a class="dropdown-item" asp-action="Subscriptions">@PopForums.Resources.Subscriptions</a>
			}
		</div>
	</li>
</ul>

<h2>@PopForums.Resources.Avatar</h2>
<pf-profileimageupload uploadurl="@Url.Action("UploadAvatar")" deleteurl="@Url.Action("DeleteAvatar")"
	imageurl="@Url.Action("Avatar", "Image")/" imageid="@Model.AvatarID"
	maxwidth="@settings.UserAvatarMaxWidth" maxheight="@settings.UserAvatarMaxHeight" maxkbytes="@settings.UserAvatarMaxkBytes" crop="true" quality="0.7"
	alttext="Avatar image" deletelabel="@PopForums.Resources.AvatarDelete" successmessage="@PopForums.Resources.AvatarUploaded"
	uploadingmessage="@PopForums.Resources.Uploading" failedmessage="@PopForums.Resources.UploadFailed"></pf-profileimageupload>

<h2>@PopForums.Resources.Photo</h2>
<pf-profileimageupload uploadurl="@Url.Action("UploadPhoto")" deleteurl="@Url.Action("DeletePhoto")"
	imageurl="@Url.Action("UserImage", "Image")/" imageid="@Model.ImageID" isapproved="@((Model.IsImageApproved ?? true).ToString().ToLower())"
	maxwidth="@settings.UserImageMaxWidth" maxheight="@settings.UserImageMaxHeight" maxkbytes="@settings.UserImageMaxkBytes" crop="false" quality="0.7"
	alttext="User image" deletelabel="@PopForums.Resources.PhotoDelete" successmessage="@PopForums.Resources.PhotoUploaded" pendingmessage="@PopForums.Resources.PhotoNotApproved"
	uploadingmessage="@PopForums.Resources.Uploading" failedmessage="@PopForums.Resources.UploadFailed"></pf-profileimageupload>
